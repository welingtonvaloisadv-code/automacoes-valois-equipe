ADVOGADO_RESPONSAVEL_EMAIL=welingtonvaloisadv@gmail.com

# -----------------------------------------------------------------------------
#  CREDENCIAIS / TOKENS  (preencher no onboarding - NENHUMA recebida ainda)
# -----------------------------------------------------------------------------
ANTHROPIC_API_KEY=
# Modelo da IA na contratacao (INTAKE). Vazio = claude-opus-5-5.
INTAKE_MODELO=
# ADVBOX - sistema juridico do escritorio (confirmar se o plano tem API liberada).
ADVBOX_API_TOKEN=
ASAAS_API_TOKEN=
ASAAS_BASE_URL=https://api.asaas.com/v3
ZAPSIGN_API_TOKEN=
ATENDE_DIREITO_TOKEN=
# Sync - Atende Direito (monitoramento PDPJ/DJEN: processos, intimacoes, prazos). Usado pelo
# INTEGRACOES/sync_atendedireito.py e pelo .mcp.json (este le a variavel de ambiente do Windows:
# setx ATENDEDIREITO_SYNC_TOKEN "sk_live_...").
ATENDEDIREITO_SYNC_TOKEN=
# Infinitum (POPs/kanban: cards, cadastros, tarefas, agenda). Public token da pagina Infinitum.
# Usado pelo INTEGRACOES/infinitum_integration.py e pelo .mcp.json (setx INFINITUM_PUBLIC_TOKEN "...").
INFINITUM_PUBLIC_TOKEN=
INFINITUM_ORG_ID=
# Infinitum - destino da migracao ADVBOX -> Infinitum (UTILS/migrar_advbox_infinitum.py).
# ORG_ID = organizacao do escritorio no Infinitum. DB_CLIENTES vazio = procura o database "Clientes".
INFINITUM_PUBLIC_TOKEN=
INFINITUM_ORG_ID=
INFINITUM_DB_CLIENTES=
# Caminho do JSON de credenciais do Google Cloud (service account ou OAuth):
GOOGLE_APPLICATION_CREDENTIALS=config/credentials.json
GOOGLE_OAUTH_CREDENTIALS=config/oauth_credentials.json
# Caminho do executavel do Tesseract (OCR), se nao estiver no PATH:
TESSERACT_CMD=
# Modelo LLM usado na geracao de pecas (opcional; ha default no codigo):
LLM_MODEL_PECA=

# -----------------------------------------------------------------------------
#  GOOGLE DRIVE / DOCS  - IDs das pastas e modelos DO ESCRITORIO
#  (crie as pastas/modelos no Drive do escritorio e cole os IDs aqui)
# -----------------------------------------------------------------------------
# Pastas de AREA na raiz do Drive. A pasta do cliente nasce dentro da area:
#   {AREA}/{NOME DO CLIENTE}/ATOS INTERNOS | DOCUMENTOS DO CLIENTE | PASTA DO CLIENTE
# Conferir com: python INTEGRACOES/google_setup.py
DRIVE_PASTA_PREVIDENCIARIO=
DRIVE_PASTA_CRIMINAL=
DRIVE_PASTA_FAMILIA_E_SUCESSOES=
DRIVE_PASTA_BANCARIO=
DRIVE_PASTA_CIVEL_E_CONSUMIDOR=
# Planilha de controle de contratos (numeracao sequencial; arquivo .xlsx no Drive, opcional):
GOOGLE_PLANILHA_CONTRATOS=
# Aba da planilha (vazio = "Contratos <ano atual>"):
GOOGLE_ABA_CONTRATOS=
# Os documentos da contratacao NAO usam mais modelos do Google Docs: saem em .docx no
# timbrado (config/timbrado_modelo.docx) a partir de INTAKE/modelos/ ou, quando o escritorio
# mandar os modelos reais, de DOCS_MODELOS/contratacao/ (ver INTAKE/modelos/LEIA-ME.md).

# -----------------------------------------------------------------------------
#  GOOGLE DRIVE  - Financeiro / Operacional
# -----------------------------------------------------------------------------
DRIVE_PASTA_FECHAMENTO_ID=
DRIVE_PASTA_FINANCEIRO_ID=
DRIVE_PLANILHA_HISTORICO_ID=
DRIVE_PLANILHA_RESULTADO_ID=
# Pasta de clientes usada pelo handler de sincronizacao de assinados:
DRIVE_PASTA_CLIENTES_ID=

# -----------------------------------------------------------------------------
#  USUARIOS ADVBOX  (IDs do painel ADVBOX > Usuarios - ver config/equipe.py)
# -----------------------------------------------------------------------------
# TODO: confirmar se ha ADVBOX e pegar ID real do Dr. Welington no painel ADVBOX > Usuarios.
ADVBOX_USER_RESPONSAVEL=
ADVBOX_USER_OPERACIONAL=
ADVBOX_USER_FINANCEIRO=
# Campo 'from' das tarefas /posts (quem assina a tarefa):
ADVBOX_USER_FROM=
# Mapa opcional p/ exibir nomes nos relatorios: "ID:NOME,ID:NOME"
ADVBOX_USERS_MAP=

# -----------------------------------------------------------------------------
#  AGENTE OPERACIONAL (VALOIS.IA)  - servidor webhook
# -----------------------------------------------------------------------------
AGENTE_OP_TOKEN=
AGENTE_OP_PORT=8787
# ID do usuario-agente no ADVBOX (conta a quem as tarefas do agente sao atribuidas):
ADVBOX_USER_AGENTE=
# Tipo de tarefa (settings['tasks']) usado nos retornos do agente:
ADVBOX_TASK_TYPE_ACOMPANHAMENTO=
# Notificacao WhatsApp ao concluir tarefa (1 = liga, 0 = desliga):
AGENTE_OP_NOTIFICAR_WHATSAPP=1
# Telefones internos p/ notificacao - JSON {"<advbox_user_id>": "<telefone>"}:
AGENTE_OP_USER_PHONES=

# -----------------------------------------------------------------------------
#  WHATSAPP - Evolution API (definida na reuniao de 14/09/2026)
#  Roda no proprio servidor/maquina do escritorio. Numero do piloto: previdenciario.
# -----------------------------------------------------------------------------
EVOLUTION_URL=http://localhost:8080
EVOLUTION_API_KEY=
EVOLUTION_INSTANCIA=valois

# -----------------------------------------------------------------------------
#  VOZ DOS RELATORIOS (edge-tts - sem chave de API)
#  Vozes pt-BR: pt-BR-AntonioNeural | pt-BR-FranciscaNeural | pt-BR-ThalitaNeural
#  O texto do relatorio sai da maquina para o servico de voz da Microsoft.
#  Se o escritorio nao quiser isso, rodar os relatorios com --sem-audio.
# -----------------------------------------------------------------------------
TTS_VOZ=pt-BR-AntonioNeural
TTS_RITMO=-8%
